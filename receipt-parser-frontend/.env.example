# Copy to .env and fill in. .env is gitignored.
#
# Neither of these has a VITE_ prefix, so Vite will NOT inline them into the
# browser bundle — they are read only by vite.config.js, which runs in Node.
# Do not add a VITE_ prefix to the secret; that would publish it.

# Same value as NETLIFY_SIGN_SECRET in the Netlify dashboard and the Modal
# secret. The dev server uses it to sign /api/* requests the way Netlify does.
NETLIFY_SIGN_SECRET=

# Optional — defaults to the deployed gateway.
MODAL_URL=https://yangalex1081--receipt-parser-fastapi-app.modal.run
